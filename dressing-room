<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>夢幻 3D 更衣室 - 時尚穿搭設計</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { margin: 0; overflow: hidden; background-color: #fce7f3; font-family: 'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        #canvas-container { width: 100vw; height: 100vh; display: block; }
        
        /* Glassmorphism UI */
        .glass-panel {
            background: rgba(255, 255, 255, 0.75);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.5);
            box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.15);
            border-radius: 20px;
        }

        .color-btn {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            border: 2px solid white;
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
        .color-btn:hover { transform: scale(1.15); }
        .color-btn.active { border-color: #ec4899; box-shadow: 0 0 0 3px rgba(236, 72, 153, 0.3); }

        .category-btn {
            transition: all 0.3s ease;
        }
        .category-btn.active {
            background-color: #fdf2f8;
            color: #db2777;
            border-left: 4px solid #db2777;
        }

        /* Loading Overlay */
        #loader {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: #fce7f3;
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 9999;
            transition: opacity 0.5s;
        }
        .spinner {
            width: 50px; height: 50px;
            border: 5px solid #fbcfe8;
            border-top: 5px solid #db2777;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #fbcfe8; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #f472b6; }
    </style>
</head>
<body>

    <!-- Loader -->
    <div id="loader">
        <div class="flex flex-col items-center">
            <div class="spinner mb-4"></div>
            <div class="text-pink-600 font-bold text-lg">正在準備更衣室...</div>
        </div>
    </div>

    <!-- 3D Canvas -->
    <div id="canvas-container"></div>

    <!-- UI Container -->
    <div class="absolute inset-0 pointer-events-none flex flex-col md:flex-row">
        
        <!-- Header / Logo (Top Left) -->
        <div class="absolute top-4 left-4 pointer-events-auto glass-panel p-4 z-10 animate-fade-in-down md:w-auto w-11/12">
            <h1 class="text-2xl font-bold text-pink-600 flex items-center"><i class="fa-solid fa-wand-magic-sparkles mr-2"></i>夢幻 3D 更衣室</h1>
            <p class="text-sm text-gray-500">拖曳旋轉 • 滾輪縮放</p>
            <div id="status-message" class="text-xs mt-2 text-pink-500 font-medium hidden"></div>
        </div>

        <!-- Controls Panel (Right Side) -->
        <div class="absolute right-4 top-4 bottom-4 w-80 max-w-[calc(100vw-32px)] pointer-events-auto glass-panel flex flex-col overflow-hidden z-10">
            
            <!-- Category Tabs -->
            <div class="flex overflow-x-auto p-2 border-b border-pink-100 bg-white/50 space-x-2 shrink-0">
                <button onclick="setTab('hair')" id="btn-hair" class="tab-btn flex-1 py-2 px-1 rounded-lg text-sm font-semibold text-gray-600 hover:bg-pink-50 transition active-tab bg-pink-100 text-pink-600">
                    <i class="fa-solid fa-scissors mb-1 block text-center"></i> 髮型
                </button>
                <button onclick="setTab('top')" id="btn-top" class="tab-btn flex-1 py-2 px-1 rounded-lg text-sm font-semibold text-gray-600 hover:bg-pink-50 transition">
                    <i class="fa-solid fa-shirt mb-1 block text-center"></i> 上衣
                </button>
                <button onclick="setTab('bottom')" id="btn-bottom" class="tab-btn flex-1 py-2 px-1 rounded-lg text-sm font-semibold text-gray-600 hover:bg-pink-50 transition">
                    <i class="fa-solid fa-layer-group mb-1 block text-center"></i> 下裝
                </button>
                <button onclick="setTab('shoes')" id="btn-shoes" class="tab-btn flex-1 py-2 px-1 rounded-lg text-sm font-semibold text-gray-600 hover:bg-pink-50 transition">
                    <i class="fa-solid fa-shoe-prints mb-1 block text-center"></i> 鞋子
                </button>
            </div>

            <!-- Content Area -->
            <div class="flex-1 overflow-y-auto p-4 space-y-6" id="panel-content">
                
                <!-- Hair Section -->
                <div id="section-hair" class="control-section">
                    <h3 class="text-pink-500 font-bold mb-3 border-b border-pink-100 pb-1">髮色選擇</h3>
                    <div class="grid grid-cols-5 gap-3" id="hair-colors"></div>
                    
                    <h3 class="text-pink-500 font-bold mb-3 mt-6 border-b border-pink-100 pb-1">膚色調整</h3>
                    <div class="grid grid-cols-5 gap-3" id="skin-colors"></div>
                </div>

                <!-- Top Section -->
                <div id="section-top" class="control-section hidden">
                    <h3 class="text-pink-500 font-bold mb-3 border-b border-pink-100 pb-1">上衣顏色</h3>
                    <div class="grid grid-cols-5 gap-3" id="top-colors"></div>
                    
                    <div class="mt-6">
                        <label class="flex items-center space-x-2 cursor-pointer bg-white p-3 rounded-lg shadow-sm border border-pink-100 hover:bg-pink-50">
                            <input type="checkbox" id="crop-top-toggle" class="accent-pink-500 w-5 h-5">
                            <span class="text-gray-700 font-medium">短版設計 (Crop Top)</span>
                        </label>
                    </div>
                </div>

                <!-- Bottom Section -->
                <div id="section-bottom" class="control-section hidden">
                    <div class="flex space-x-2 mb-4 bg-pink-50 p-1 rounded-lg">
                        <button onclick="setType('skirt')" id="type-skirt" class="flex-1 py-2 rounded-md text-sm font-bold bg-white text-pink-600 shadow-sm transition">裙子</button>
                        <button onclick="setType('pants')" id="type-pants" class="flex-1 py-2 rounded-md text-sm font-bold text-gray-500 hover:bg-white/50 transition">褲子</button>
                    </div>

                    <h3 class="text-pink-500 font-bold mb-3 border-b border-pink-100 pb-1">下裝顏色</h3>
                    <div class="grid grid-cols-5 gap-3" id="bottom-colors"></div>
                </div>

                <!-- Shoes Section -->
                <div id="section-shoes" class="control-section hidden">
                    <h3 class="text-pink-500 font-bold mb-3 border-b border-pink-100 pb-1">鞋子顏色</h3>
                    <div class="grid grid-cols-5 gap-3" id="shoe-colors"></div>
                </div>

            </div>

            <!-- Footer Actions -->
            <div class="p-4 border-t border-pink-100 bg-white/50 shrink-0 space-y-2">
                <button onclick="saveAndShareOutfit()" class="w-full bg-gradient-to-r from-pink-400 to-rose-400 text-white font-bold py-3 px-4 rounded-xl shadow-lg transform active:scale-95 transition hover:shadow-pink-300/50 hover:from-pink-500 hover:to-rose-500 flex justify-center items-center">
                    <i class="fa-solid fa-share-nodes mr-2"></i> 保存並分享穿搭
                </button>
                <button onclick="takeScreenshot()" class="w-full bg-white text-pink-600 border border-pink-300 font-bold py-3 px-4 rounded-xl shadow-md transform active:scale-95 transition hover:bg-pink-50 flex justify-center items-center">
                    <i class="fa-solid fa-camera mr-2"></i> 拍照 (PNG)
                </button>
            </div>
        </div>
    </div>

    <!-- Three.js Library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
    
    <!-- Firebase Libraries -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, doc, setDoc, getDoc, collection } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";
        import { setLogLevel } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // Global Firebase exports for use in the main script
        window.FirebaseServices = {
            initializeApp, getAuth, signInAnonymously, signInWithCustomToken, onAuthStateChanged, 
            getFirestore, doc, setDoc, getDoc, collection, setLogLevel
        };
    </script>

    <script>
        // --- Global Firebase Vars (Will be initialized on window.onload) ---
        let db, auth;
        let userId = null;
        let isAuthReady = false;
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'default-app-id';
        const firebaseConfig = JSON.parse(typeof __firebase_config !== 'undefined' ? __firebase_config : '{}');

        // --- Game Config & State ---
        const config = {
            colors: {
                hair: ['#2c1b18', '#5e3a28', '#d4af37', '#a52a2a', '#ffb6c1', '#e6e6fa', '#c0c0c0', '#ff0000'],
                skin: ['#ffe0bd', '#ffcd94', '#eac086', '#8d5524', '#c68642'],
                clothes: ['#ffffff', '#000000', '#ff69b4', '#87ceeb', '#9370db', '#90ee90', '#ffa500', '#ff6347', '#ffd700', '#40e0d0'],
            },
            default: {
                hair: '#5e3a28',
                skin: '#ffe0bd',
                top: '#ff69b4',
                bottom: '#87ceeb',
                shoes: '#ffffff',
                bottomType: 'skirt',
                isCropTop: false
            }
        };

        const outfitState = {
            hairColor: config.default.hair,
            skinColor: config.default.skin,
            topColor: config.default.top,
            bottomColor: config.default.bottom,
            shoeColor: config.default.shoes,
            bottomType: config.default.bottomType,
            isCropTop: config.default.isCropTop
        };

        let state = {
            currentTab: 'hair'
        };

        // --- Three.js Variables ---
        let scene, camera, renderer, controls;
        let characterGroup;
        let materials = {}; // Store materials to update colors easily
        let meshes = {}; // Store meshes to toggle visibility

        // --- Utility Functions ---
        function showMessage(msg, duration = 3000) {
            const el = document.getElementById('status-message');
            el.textContent = msg;
            el.classList.remove('hidden');
            setTimeout(() => { el.classList.add('hidden'); }, duration);
        }

        function getAppState() {
            return {
                hairColor: materials.hair.color.getHexString(),
                skinColor: materials.skin.color.getHexString(),
                topColor: materials.top.color.getHexString(),
                bottomColor: materials.bottom.color.getHexString(),
                shoeColor: materials.shoes.color.getHexString(),
                bottomType: outfitState.bottomType,
                isCropTop: outfitState.isCropTop
            };
        }

        function applyAppState(data) {
            if (!data) return;

            // Apply colors
            if (materials.hair) materials.hair.color.set(`#${data.hairColor}`);
            if (materials.skin) materials.skin.color.set(`#${data.skinColor}`);
            if (materials.top) materials.top.color.set(`#${data.topColor}`);
            if (materials.bottom) materials.bottom.color.set(`#${data.bottomColor}`);
            if (materials.shoes) materials.shoes.color.set(`#${data.shoeColor}`);

            // Apply other settings
            if (data.bottomType) setType(data.bottomType);
            if (typeof data.isCropTop === 'boolean') {
                const checkbox = document.getElementById('crop-top-toggle');
                checkbox.checked = data.isCropTop;
                toggleCropTop(data.isCropTop);
            }

            // Update UI buttons based on applied state (re-activate the correct color buttons)
            updateColorButtonUI('hair-colors', `#${data.hairColor}`);
            updateColorButtonUI('skin-colors', `#${data.skinColor}`);
            updateColorButtonUI('top-colors', `#${data.topColor}`);
            updateColorButtonUI('bottom-colors', `#${data.bottomColor}`);
            updateColorButtonUI('shoe-colors', `#${data.shoeColor}`);
            
            showMessage('穿搭已成功載入！', 4000);
        }
        
        function updateColorButtonUI(containerId, hexColor) {
            const container = document.getElementById(containerId);
            if (!container) return;
            Array.from(container.children).forEach(btn => {
                btn.classList.remove('active');
                if (btn.style.backgroundColor.toLowerCase() === hexColor.toLowerCase()) {
                    btn.classList.add('active');
                }
            });
        }

        // --- Firebase Functions ---
        async function setupFirebase() {
            if (Object.keys(firebaseConfig).length === 0) {
                console.error("Firebase config is empty. Cannot initialize Firestore.");
                return;
            }
            
            const { initializeApp, getAuth, signInAnonymously, signInWithCustomToken, onAuthStateChanged, getFirestore, setLogLevel } = window.FirebaseServices;

            // Set log level for debugging
            setLogLevel('debug');
            
            const app = initializeApp(firebaseConfig);
            auth = getAuth(app);
            db = getFirestore(app);

            // Handle Authentication
            onAuthStateChanged(auth, async (user) => {
                if (user) {
                    userId = user.uid;
                    isAuthReady = true;
                    console.log("Firebase Auth Ready. User ID:", userId);
                    // Check for outfit ID in URL once auth is ready
                    loadOutfitFromUrl();
                } else {
                    // Sign in anonymously if no token or user is available
                    try {
                        const token = typeof __initial_auth_token !== 'undefined' ? __initial_auth_token : null;
                        if (token) {
                            await signInWithCustomToken(auth, token);
                        } else {
                            await signInAnonymously(auth);
                        }
                    } catch (error) {
                        console.error("Firebase Sign-In Failed:", error);
                    }
                }
            });
        }

        async function saveOutfitToFirestore() {
            if (!isAuthReady) {
                showMessage("Firebase 正在初始化，請稍候再試。");
                return null;
            }

            const outfitData = getAppState();
            const outfitId = `outfit_${Date.now()}_${Math.random().toString(36).substring(2, 9)}`;
            
            // Public path for shared data: /artifacts/{appId}/public/data/outfits/{outfitId}
            const { doc, setDoc, collection } = window.FirebaseServices;
            const collectionPath = `artifacts/${appId}/public/data/outfits`;
            const outfitDocRef = doc(collection(db, collectionPath), outfitId);

            try {
                await setDoc(outfitDocRef, outfitData);
                console.log("Outfit saved successfully with ID:", outfitId);
                return outfitId;
            } catch (error) {
                console.error("Error saving outfit to Firestore:", error);
                showMessage("保存穿搭失敗，請檢查控制台錯誤訊息。", 5000);
                return null;
            }
        }

        async function loadOutfitFromFirestore(outfitId) {
            if (!isAuthReady) {
                console.log("Auth not ready yet, waiting...");
                return null;
            }
            if (!outfitId) return;

            const { doc, getDoc, collection } = window.FirebaseServices;
            const collectionPath = `artifacts/${appId}/public/data/outfits`;
            const outfitDocRef = doc(collection(db, collectionPath), outfitId);

            try {
                const docSnap = await getDoc(outfitDocRef);

                if (docSnap.exists()) {
                    const data = docSnap.data();
                    console.log("Outfit data loaded:", data);
                    applyAppState(data);
                } else {
                    showMessage("找不到此穿搭 ID，已載入預設穿搭。", 5000);
                    console.log("No such outfit document:", outfitId);
                }
            } catch (error) {
                console.error("Error loading outfit from Firestore:", error);
                showMessage("載入穿搭資料失敗。", 5000);
            }
        }

        function loadOutfitFromUrl() {
            const urlParams = new URLSearchParams(window.location.search);
            const outfitId = urlParams.get('id');
            if (outfitId && isAuthReady) {
                loadOutfitFromFirestore(outfitId);
                // Adjust camera target to center view immediately on load
                controls.target.set(0, 2, 0);
                controls.update(); // Add this line to ensure the target change is immediately applied
            }
        }

        async function saveAndShareOutfit() {
            const button = document.querySelector('.w-full.bg-gradient-to-r');
            button.disabled = true;
            button.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-2"></i> 正在儲存...';

            const outfitId = await saveOutfitToFirestore();

            button.disabled = false;
            button.innerHTML = '<i class="fa-solid fa-share-nodes mr-2"></i> 保存並分享穿搭';

            if (outfitId) {
                // Construct the public link using the current URL base + the new ID
                const baseUrl = window.location.origin + window.location.pathname;
                const shareLink = `${baseUrl}?id=${outfitId}`;

                // Use the screenshot function's feedback mechanism to show the link
                showMessage(`穿搭已保存！連結已複製到剪貼簿。`, 6000);
                
                // Copy link to clipboard
                try {
                    // Older browsers compatibility
                    const textarea = document.createElement('textarea');
                    textarea.value = shareLink;
                    document.body.appendChild(textarea);
                    textarea.select();
                    document.execCommand('copy');
                    document.body.removeChild(textarea);

                } catch (err) {
                    console.error('無法複製連結', err);
                    showMessage(`穿搭已保存。連結: ${shareLink}`, 10000);
                }
            }
        }

        // --- Initialization (including Three.js and UI setup) ---
        function init() {
            try {
                // Setup Firebase
                if (window.FirebaseServices) {
                    // Slight delay to ensure module script execution is finalized
                    setTimeout(setupFirebase, 0); 
                } else {
                    console.error("Firebase module not loaded. Sharing functionality disabled.");
                }

                // Scene Setup
                scene = new THREE.Scene();
                scene.background = new THREE.Color(0xfce7f3); 
                scene.fog = new THREE.Fog(0xfce7f3, 10, 50);

                // Camera
                camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 100);
                camera.position.set(0, 3, 8);

                // Renderer
                renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true, preserveDrawingBuffer: true });
                renderer.setSize(window.innerWidth, window.innerHeight);
                renderer.shadowMap.enabled = true;
                renderer.shadowMap.type = THREE.SoftShadowMap;
                document.getElementById('canvas-container').appendChild(renderer.domElement);

                // Lighting
                const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
                scene.add(ambientLight);

                const dirLight = new THREE.DirectionalLight(0xffffff, 0.8);
                dirLight.position.set(5, 10, 7);
                dirLight.castShadow = true;
                dirLight.shadow.mapSize.width = 1024;
                dirLight.shadow.mapSize.height = 1024;
                scene.add(dirLight);

                const backLight = new THREE.DirectionalLight(0xffffff, 0.3);
                backLight.position.set(-5, 5, -5);
                scene.add(backLight);

                // Floor
                const planeGeometry = new THREE.PlaneGeometry(50, 50);
                const planeMaterial = new THREE.MeshPhongMaterial({ color: 0xffffff, depthWrite: false });
                const plane = new THREE.Mesh(planeGeometry, planeMaterial);
                plane.rotation.x = -Math.PI / 2;
                plane.receiveShadow = true;
                scene.add(plane);

                // Grid Helper (Subtle)
                const grid = new THREE.GridHelper(50, 50, 0xfbcfe8, 0xffffff);
                grid.material.opacity = 0.4;
                grid.material.transparent = true;
                scene.add(grid);

                // Controls
                controls = new THREE.OrbitControls(camera, renderer.domElement);
                controls.enableDamping = true;
                controls.dampingFactor = 0.05;
                controls.minDistance = 3;
                controls.maxDistance = 15;
                controls.target.set(0, 2, 0);
                controls.maxPolarAngle = Math.PI / 2 - 0.05; 

                // Build Character
                createCharacter();

                // Setup UI
                setupUI();

                // Event Listeners
                window.addEventListener('resize', onWindowResize);
                document.getElementById('crop-top-toggle').addEventListener('change', (e) => toggleCropTop(e.target.checked));

                // Start Loop
                animate();

            } catch (e) {
                console.error("Three.js initialization failed:", e);
                // Display error message in the loader area
                document.getElementById('loader').innerHTML = '<div class="flex flex-col items-center"><i class="fa-solid fa-triangle-exclamation text-red-600 text-3xl mb-4"></i><div class="text-red-600 font-bold text-lg">初始化失敗，請檢查控制台錯誤訊息！</div><p class="text-sm text-gray-500 mt-2">（可能是 Three.js 依賴載入問題）</p></div>';
            }
            
            // Remove Loader after delay, regardless of success (unless crashed and replaced content)
            setTimeout(() => {
                const loader = document.getElementById('loader');
                if (loader && loader.style.opacity !== '0') {
                    loader.style.opacity = '0';
                    setTimeout(() => loader.remove(), 500);
                }
            }, 1500);
        }

        // --- Character Creation (Procedural Stylized Model) ---
        function createCharacter() {
            characterGroup = new THREE.Group();
            
            // Shared Materials, initialized with default/current state
            materials.skin = new THREE.MeshToonMaterial({ color: outfitState.skinColor });
            materials.hair = new THREE.MeshStandardMaterial({ color: outfitState.hairColor, roughness: 0.3 });
            materials.top = new THREE.MeshToonMaterial({ color: outfitState.topColor });
            materials.bottom = new THREE.MeshToonMaterial({ color: outfitState.bottomColor });
            materials.shoes = new THREE.MeshStandardMaterial({ color: outfitState.shoeColor });
            materials.eyes = new THREE.MeshBasicMaterial({ color: 0x333333 });

            // 1. Legs (Left & Right)
            // Left Leg
            const leftLegGroup = new THREE.Group();
            leftLegGroup.position.set(-0.25, 1.4, 0);
            
            const lPants = new THREE.Mesh(new THREE.CylinderGeometry(0.2, 0.18, 3, 32), materials.bottom);
            lPants.castShadow = true;
            meshes.lPants = lPants;
            
            const lBareLeg = new THREE.Mesh(new THREE.CylinderGeometry(0.19, 0.15, 3, 32), materials.skin);
            lBareLeg.castShadow = true;
            meshes.lBareLeg = lBareLeg;

            const lShoe = new THREE.Mesh(new THREE.SphereGeometry(0.25, 16, 16), materials.shoes);
            lShoe.scale.set(0.7, 0.5, 1.5); 
            lShoe.position.y = -1.5;
            lShoe.position.z = 0.1;
            lShoe.castShadow = true;

            leftLegGroup.add(lPants, lBareLeg, lShoe);
            characterGroup.add(leftLegGroup);

            // Right Leg
            const rightLegGroup = new THREE.Group();
            rightLegGroup.position.set(0.25, 1.4, 0);
            
            const rPants = new THREE.Mesh(new THREE.CylinderGeometry(0.2, 0.18, 3, 32), materials.bottom);
            rPants.castShadow = true;
            meshes.rPants = rPants;

            const rBareLeg = new THREE.Mesh(new THREE.CylinderGeometry(0.19, 0.15, 3, 32), materials.skin);
            rBareLeg.castShadow = true;
            meshes.rBareLeg = rBareLeg;

            const rShoe = lShoe.clone();
            rightLegGroup.add(rPants, rBareLeg, rShoe);
            characterGroup.add(rightLegGroup);

            // 2. Torso
            // Hips
            const hipGeo = new THREE.CylinderGeometry(0.45, 0.5, 0.6, 32);
            const hips = new THREE.Mesh(hipGeo, materials.bottom); 
            hips.position.y = 3.0;
            meshes.hips = hips; 
            characterGroup.add(hips);

            // Body/Shirt (Normal length)
            const bodyGeo = new THREE.CylinderGeometry(0.4, 0.45, 1.6, 32);
            const body = new THREE.Mesh(bodyGeo, materials.top);
            body.position.y = 4.1;
            body.castShadow = true;
            meshes.body = body;
            characterGroup.add(body);

            // Crop Top Belly (Skin) - hidden by default
            const bellyGeo = new THREE.CylinderGeometry(0.44, 0.45, 0.5, 32);
            const belly = new THREE.Mesh(bellyGeo, materials.skin);
            belly.position.y = 3.55;
            belly.visible = false;
            meshes.belly = belly;
            characterGroup.add(belly);

            // 3. Skirt (Cone)
            const skirtGeo = new THREE.ConeGeometry(0.65, 1.8, 32, 1, true); 
            const skirt = new THREE.Mesh(skirtGeo, materials.bottom);
            skirt.position.y = 3.2;
            meshes.skirt = skirt;
            characterGroup.add(skirt);

            // 4. Arms (Simplified creation)
            function createArm(x, rotZ) {
                const armGroup = new THREE.Group();
                armGroup.position.set(x, 4.6, 0);
                
                const shoulder = new THREE.Mesh(new THREE.SphereGeometry(0.22, 16, 16), materials.top);
                meshes.shoulders = meshes.shoulders || [];
                meshes.shoulders.push(shoulder);
                armGroup.add(shoulder);

                const upperArm = new THREE.Mesh(new THREE.CylinderGeometry(0.12, 0.12, 1.2, 16), materials.skin);
                upperArm.position.y = -0.6;
                upperArm.rotation.z = rotZ;
                armGroup.add(upperArm);
                
                const forearm = new THREE.Mesh(new THREE.CylinderGeometry(0.1, 0.08, 1.2, 16), materials.skin);
                forearm.position.set(rotZ > 0 ? 0.3 : -0.3, -1.6, 0.2); 
                forearm.rotation.x = -0.2;
                forearm.rotation.z = rotZ * 0.5;
                armGroup.add(forearm);

                const hand = new THREE.Mesh(new THREE.SphereGeometry(0.12, 16, 16), materials.skin);
                hand.position.set(0, -0.6, 0);
                forearm.add(hand);

                return armGroup;
            }

            characterGroup.add(createArm(-0.5, 0.2));
            characterGroup.add(createArm(0.5, -0.2));

            // 5. Head
            const headGroup = new THREE.Group();
            headGroup.position.y = 5.0;

            const neck = new THREE.Mesh(new THREE.CylinderGeometry(0.12, 0.15, 0.6, 16), materials.skin);
            neck.position.y = 0;
            headGroup.add(neck);

            const headGeo = new THREE.SphereGeometry(0.45, 32, 32);
            headGeo.scale(1, 1.1, 1);
            const head = new THREE.Mesh(headGeo, materials.skin);
            head.position.y = 0.6;
            head.castShadow = true;
            headGroup.add(head);

            // Eyes 
            const eyeGeo = new THREE.SphereGeometry(0.06, 16, 16);
            const leftEye = new THREE.Mesh(eyeGeo, materials.eyes);
            leftEye.position.set(-0.15, 0.65, 0.42);
            const rightEye = new THREE.Mesh(eyeGeo, materials.eyes);
            rightEye.position.set(0.15, 0.65, 0.42);
            headGroup.add(leftEye, rightEye);

            // Hair 
            const hairGroup = new THREE.Group();
            meshes.hair = hairGroup; 

            const backHair = new THREE.Mesh(new THREE.SphereGeometry(0.5, 32, 32, 0, Math.PI * 2, 0, Math.PI/2), materials.hair);
            backHair.scale.set(1, 1.2, 1.1);
            backHair.position.y = 0.6;
            hairGroup.add(backHair);

            const bangs = new THREE.Mesh(new THREE.SphereGeometry(0.48, 32, 32, 0, Math.PI * 2, 0, Math.PI * 0.25), materials.hair);
            bangs.rotation.x = -Math.PI / 4;
            bangs.position.y = 0.6;
            hairGroup.add(bangs);

            const tailGeo = new THREE.ConeGeometry(0.15, 1, 16);
            const leftTail = new THREE.Mesh(tailGeo, materials.hair);
            leftTail.position.set(-0.5, 0.4, -0.2);
            leftTail.rotation.z = 0.5;
            leftTail.rotation.x = -0.5;
            
            const rightTail = new THREE.Mesh(tailGeo, materials.hair);
            rightTail.position.set(0.5, 0.4, -0.2);
            rightTail.rotation.z = -0.5;
            rightTail.rotation.x = -0.5;

            hairGroup.add(leftTail, rightTail);

            headGroup.add(hairGroup);
            characterGroup.add(headGroup);

            // Initial Setup Logic
            scene.add(characterGroup);
            updateBottomVisibility(); 
            toggleCropTop(outfitState.isCropTop);
        }

        // --- Logic & UI Functions ---

        function setupUI() {
            // Helper to find initial active index for UI
            const findInitialIndex = (colors, currentColor) => colors.findIndex(c => c === currentColor) >= 0 ? colors.findIndex(c => c === currentColor) : 0;

            const createColorBtns = (colors, containerId, targetStateKey) => {
                const container = document.getElementById(containerId);
                const initialColor = outfitState[targetStateKey] || config.default[targetStateKey.replace('Color', '')];
                const activeIndex = findInitialIndex(colors, initialColor);

                colors.forEach((c, idx) => {
                    const btn = document.createElement('div');
                    btn.className = `color-btn ${idx === activeIndex ? 'active' : ''}`;
                    btn.style.backgroundColor = c;
                    btn.onclick = () => {
                        // Update material, state, and UI
                        materials[targetStateKey.replace('Color', '')].color.set(c);
                        outfitState[targetStateKey] = c;
                        
                        Array.from(container.children).forEach(child => child.classList.remove('active'));
                        btn.classList.add('active');
                    };
                    container.appendChild(btn);
                });
            };

            // Hair Colors
            createColorBtns(config.colors.hair, 'hair-colors', 'hairColor');

            // Skin Colors
            createColorBtns(config.colors.skin, 'skin-colors', 'skinColor');

            // Top Colors
            createColorBtns(config.colors.clothes, 'top-colors', 'topColor');

            // Bottom Colors
            createColorBtns(config.colors.clothes, 'bottom-colors', 'bottomColor');

            // Shoe Colors
            createColorBtns(config.colors.clothes, 'shoe-colors', 'shoeColor');

            // Set initial bottom type UI state
            setType(outfitState.bottomType);
            
            // Set initial crop top UI state
            document.getElementById('crop-top-toggle').checked = outfitState.isCropTop;
        }

        function setTab(tabName) {
            state.currentTab = tabName;
            
            document.querySelectorAll('.control-section').forEach(el => el.classList.add('hidden'));
            document.getElementById(`section-${tabName}`).classList.remove('hidden');

            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.classList.remove('active-tab', 'bg-pink-100', 'text-pink-600');
            });
            const activeBtn = document.getElementById(`btn-${tabName}`);
            activeBtn.classList.add('active-tab', 'bg-pink-100', 'text-pink-600');

            const targetY = tabName === 'shoes' ? 1 : (tabName === 'hair' ? 5 : 3);
            new TWEEN_Camera(targetY);
        }

        function setType(type) {
            outfitState.bottomType = type;
            
            const btnSkirt = document.getElementById('type-skirt');
            const btnPants = document.getElementById('type-pants');
            
            // Tailwind class manipulation for active state
            const activeClasses = "bg-white text-pink-600 shadow-sm";
            const inactiveClasses = "text-gray-500 hover:bg-white/50";
            
            if(type === 'skirt') {
                btnSkirt.classList.add(...activeClasses.split(' '));
                btnSkirt.classList.remove(...inactiveClasses.split(' '));
                btnPants.classList.add(...inactiveClasses.split(' '));
                btnPants.classList.remove(...activeClasses.split(' '));
            } else {
                btnPants.classList.add(...activeClasses.split(' '));
                btnPants.classList.remove(...inactiveClasses.split(' '));
                btnSkirt.classList.add(...inactiveClasses.split(' '));
                btnSkirt.classList.remove(...activeClasses.split(' '));
            }

            updateBottomVisibility();
        }

        function toggleCropTop(isCrop) {
            outfitState.isCropTop = isCrop;
            
            if(isCrop) {
                // Shorten body (Crop Top)
                meshes.body.scale.set(1, 0.7, 1);
                meshes.body.position.y = 4.35; 
                meshes.belly.visible = true;
            } else {
                // Restore body (Normal Top)
                meshes.body.scale.set(1, 1, 1);
                meshes.body.position.y = 4.1;
                meshes.belly.visible = false;
            }
        }

        function updateBottomVisibility() {
            // Determine visibility based on outfitState.bottomType
            const isSkirt = outfitState.bottomType === 'skirt';
            
            meshes.skirt.visible = isSkirt;
            // Hips are always visible and take the bottom color (either skirt top or pants top)
            meshes.hips.visible = true; 
            
            meshes.lPants.visible = !isSkirt;
            meshes.rPants.visible = !isSkirt;
            
            meshes.lBareLeg.visible = isSkirt; // Bare legs shown with skirt
            meshes.rBareLeg.visible = isSkirt;
        }

        // Simple Camera Tween (Manual implementation to avoid extra libraries)
        function TWEEN_Camera(targetY) {
            const startY = controls.target.y;
            const diff = targetY - startY;
            let progress = 0;
            const duration = 20; // steps

            function step() {
                progress += 1 / duration;
                if(progress <= 1) {
                    // Easing function (ease-out cubic)
                    const easedProgress = 1 - Math.pow(1 - progress, 3); 
                    controls.target.y = startY + (diff * easedProgress);
                    requestAnimationFrame(step);
                } else {
                    controls.target.y = targetY; // Snap to final position
                }
            }
            step();
        }

        function takeScreenshot() {
            renderer.render(scene, camera);
            const dataURL = renderer.domElement.toDataURL('image/png');
            const link = document.createElement('a');
            link.download = 'my-dream-outfit.png';
            link.href = dataURL;
            link.click();
            
            // Visual Feedback
            const flash = document.createElement('div');
            flash.style.position = 'fixed';
            flash.style.top = '0'; flash.style.left = '0'; flash.style.width = '100%'; flash.style.height = '100%';
            flash.style.background = 'white';
            flash.style.opacity = '0.8';
            flash.style.pointerEvents = 'none';
            flash.style.zIndex = '9999';
            document.body.appendChild(flash);
            setTimeout(() => { flash.style.opacity = '0'; setTimeout(() => flash.remove(), 500); }, 50);
        }

        // --- Core Loop ---
        function onWindowResize() {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        }

        function animate() {
            requestAnimationFrame(animate);
            controls.update();
            renderer.render(scene, camera);
        }

        // Init
        window.onload = init;

    </script>
</body>
